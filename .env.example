# Copy to .env and fill in. `openssl rand -hex 32` makes good secrets.
SMRITI_OWNER_SECRET=
SMRITI_SIGNING_KEY=
POSTGRES_PASSWORD=smriti

# Files go to a Docker volume by default. For S3, R2, B2 or a MinIO you run yourself:
# SMRITI_STORAGE_BACKEND=s3
# SMRITI_S3_ENDPOINT=https://...
# SMRITI_S3_BUCKET=smriti
# SMRITI_S3_ACCESS_KEY=
# SMRITI_S3_SECRET_KEY=

# Where browsers reach the API and the web app.
SMRITI_PUBLIC_API_URL=http://localhost:8000
SMRITI_WEB_URL=http://localhost:3000

# Models. Nothing leaves the machine unless you point a step at an external provider.
# none | ollama | openai (any OpenAI-compatible API)
SMRITI_LLM_PROVIDER=none
SMRITI_LLM_MODEL=qwen2.5:3b-instruct
# An Ollama vision model for image captions and alt text, e.g. moondream or llava.
SMRITI_CAPTION_MODEL=
SMRITI_OPENAI_BASE_URL=https://api.openai.com/v1
SMRITI_OPENAI_API_KEY=
# Fixed at install time: changing it later needs a re-embed (see docs/models.md).
SMRITI_EMBED_PROVIDER=fastembed
SMRITI_EMBED_MODEL=BAAI/bge-small-en-v1.5
SMRITI_EMBED_DIM=384
SMRITI_VISION_ENABLED=true

# Optional features with heavier images.
WITH_BROWSER=0
SMRITI_BROWSER_ENABLED=false
WITH_WHISPER=0

# Email capture: POST https://your-host/inbound/email/<secret> from your mail provider.
SMRITI_INBOUND_EMAIL_SECRET=

# Weekly digest by email (opt in from Settings too).
SMRITI_DIGEST_EMAIL_TO=
SMRITI_SMTP_HOST=
SMRITI_SMTP_USER=
SMRITI_SMTP_PASSWORD=
SMRITI_SMTP_FROM=smriti@localhost

OTEL_EXPORTER_OTLP_ENDPOINT=
