{
  "manifest_version": 3,
  "name": "Smriti",
  "version": "0.1.0",
  "description": "Save the page, a selection or an image to your Smriti library.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Save to Smriti" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"], "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Open the save panel" },
    "quick-save": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Save this page without the panel" }
  },
  "browser_specific_settings": { "gecko": { "id": "smriti@azmainadel", "strict_min_version": "128.0" } }
}
